# Kallisto Docker deployment environment
# Copy this file to .env on the VM and replace every placeholder before running docker compose.

# Runtime
APP_ENV=production
SECRET_KEY=replace-with-a-random-64-character-secret

# PostgreSQL container
POSTGRES_DB=admin_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password

# Public ports exposed by docker compose.
# For a VM with Nginx/Caddy/Traefik in front, keep backend bound to localhost.
# Set FRONTEND_PORT=80 if this compose stack should serve HTTP directly.
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8081
FRONTEND_PORT=80

# Browser/API security
# Use your real production origin here, for example https://kallisto.ink.
CORS_ALLOWED_ORIGINS=https://your-domain.example
CORS_ALLOWED_HEADERS=Content-Type, Authorization, X-Requested-With, X-CSRF-Token
CORS_ALLOWED_METHODS=GET, POST, PUT, PATCH, DELETE, OPTIONS
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.your-domain.example

# Frontend session behavior. This value is baked at frontend image build time.
VITE_SESSION_IDLE_TIMEOUT_MINUTES=60

# Feature flags
APPLICATIONS_ENABLED=true
BILLING_ENABLED=true
PREMIUM_ENABLED=true
COMPARE_PREMIUM_REQUIRED=true
MATCH_SCORE_PREMIUM_REQUIRED=true

# Payments
# Production needs a real provider integration/configuration. Development uses backend-only mock completion.
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_MERCHANT_ID=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=https://your-domain.example/applicant/billing
PAYMENT_CANCEL_URL=https://your-domain.example/applicant/billing
